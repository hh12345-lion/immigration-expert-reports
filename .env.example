# Lead notification webhook (n8n) — Lead_notification_setup.md
# Set in Netlify → Environment variables and local .env for `netlify dev`.
# Do not commit real URLs. Fallback name: LEAD_NOTIFICATION_URL
Lead_notification_url=

# Google Sheets (contact form → append row) — Google_sheets_setup.md
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Private key: keep literal \n escapes inside double quotes (do not paste real newlines).
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_TAB_NAME=Sheet1

# Sheet row 1 headers (must match lib/submit-lead.ts LEAD_SHEET_COLUMNS):
# Timestamp | Full Name | Organisation | Email | Phone | Report Type | Country / Region | Proceedings | Funding | Case Summary | Brand Name
# Share the spreadsheet with the service account email as Editor.
